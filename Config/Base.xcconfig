// Defaults; Secrets.xcconfig (gitignored) overrides them.
WELA_BUNDLE_ID = com.example.wela
MS_CLIENT_ID =
GOOGLE_CLIENT_ID =
GOOGLE_REDIRECT_SCHEME = com.example.wela.google
// Entitlements without the Keychain group, so unsigned/ad-hoc builds (CI) still launch.
WELA_ENTITLEMENTS = App/Wela.entitlements
MACOSX_DEPLOYMENT_TARGET = 14.0
IPHONEOS_DEPLOYMENT_TARGET = 17.0
SWIFT_VERSION = 5.0

// iOS app and widgets. They share the bundle id with the Mac app, so one Microsoft redirect
// (msauth.<bundle id>://auth) and one Google iOS client cover both platforms.
WELA_APP_GROUP = group.$(WELA_BUNDLE_ID)
// App Store version (shown to people) and build number (must go up with every upload).
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

#include? "Secrets.xcconfig"
