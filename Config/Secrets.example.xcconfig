// Copy to Secrets.xcconfig (done by `make bootstrap`) and fill in. Never commit Secrets.xcconfig.
WELA_BUNDLE_ID = com.example.wela
MS_CLIENT_ID = 00000000-0000-0000-0000-000000000000
GOOGLE_CLIENT_ID = 000000000000-xxxxxxxx.apps.googleusercontent.com
// Reversed Google client ID, e.g. com.googleusercontent.apps.000000000000-xxxxxxxx
GOOGLE_REDIRECT_SCHEME = com.googleusercontent.apps.000000000000-xxxxxxxx
DEVELOPMENT_TEAM =

// Once DEVELOPMENT_TEAM is set, use the entitlements with MSAL's Keychain access group:
// WELA_ENTITLEMENTS = App/Wela.signed.entitlements

// iOS: the App Group shared by the app and its widgets (create it in the developer portal).
// Defaults to group.<WELA_BUNDLE_ID>.
// WELA_APP_GROUP = group.com.example.wela
